# Copiar a .env sólo si querés cambiar algo: sin .env, PanelLab arranca en modo demo.
# Nunca subir el .env real: puede contener la clave del proveedor.

# --- Modo ---
# demo: decisiones deterministas, sin red ni costo. live: proveedor real.
PANEL_LLM_MODE=demo
PANEL_WEB_PORT=8080
PANEL_PHOENIX_PORT=6007

# --- Proveedor (sólo live) ---
PANEL_OPENAI_API_KEY=
# Cualquier API compatible con OpenAI (chat/completions + embeddings).
PANEL_LLM_BASE_URL=https://api.openai.com/v1
# Modelos con tarifa verificada en backend/app/llm.py: gpt-6-luna, gpt-4o-mini.
PANEL_CHAT_MODEL=gpt-6-luna
PANEL_REASONING_EFFORT=low
# Incluye tokens de razonamiento y respuesta.
PANEL_MAX_OUTPUT_TOKENS=4000
PANEL_EMBEDDING_MODEL=text-embedding-3-small
PANEL_EMBEDDING_DIMENSIONS=1536
PANEL_RAG_INDEX=panellab:chunks

# --- Presupuesto live (persistido en Redis) ---
# Techo acumulado en USD y gasto previo a descontar (por ejemplo, de otras pruebas).
PANEL_BUDGET_CAP_USD=0.95
PANEL_BUDGET_PRIOR_USD=0

# --- Observabilidad (Arize Phoenix) ---
PANEL_PHOENIX_PROJECT=panellab
# false reemplaza prompts, fragmentos y respuestas por un marcador en las trazas.
PANEL_TRACE_CONTENT=true
