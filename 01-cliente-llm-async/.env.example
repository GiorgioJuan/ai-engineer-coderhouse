# Proveedor por defecto si no se pasa por linea de comandos: openai | anthropic
LLM_PROVIDER=openai

# Claves de API (dejar vacia la del proveedor que no uses)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Modelos (opcional; si se omiten se usan los defaults de main.py)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# Parametros de inferencia (opcional)
TEMPERATURE=0.7
MAX_TOKENS=512
TIMEOUT=30
