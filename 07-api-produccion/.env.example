# --- Redis ---
REDIS_URL=redis://localhost:6379/0
JOB_TTL=3600

# --- Modelo ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# --- Orquestador ---
MAX_PASOS=6
RECURSION_LIMIT=25
# Costo en USD a partir del cual una accion requiere aprobacion humana.
UMBRAL_COSTO_CRITICO=1000

# --- Observabilidad: phoenix | langsmith | none ---
OBSERVABILIDAD=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-multiagente

# Solo si OBSERVABILIDAD=langsmith
LANGSMITH_API_KEY=lsv2_...
