# La API key de OpenAI es obligatoria: los embeddings siempre son de OpenAI.
OPENAI_API_KEY=sk-...

# Proveedor del LLM que genera la respuesta: openai | anthropic
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-...

# Modelos (opcional)
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
MAX_TOKENS=700
