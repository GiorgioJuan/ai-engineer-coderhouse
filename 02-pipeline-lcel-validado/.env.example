# Proveedor a usar: openai | anthropic
LLM_PROVIDER=openai

# Clave del proveedor elegido
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Modelos (opcional)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5

# Tope de tokens de la respuesta. Si lo bajas mucho vas a ver el pipeline
# detectar finish_reason=length y reintentar.
MAX_TOKENS=512
